# Generated by Home Manager.
set header_cache = "/home/vkonda/.cache/neomutt/headers/"
set message_cachedir = "/home/vkonda/.cache/neomutt/messages/"
set editor = "nvim +':set textwidth=0'"
set implicit_autoview = yes
set crypt_use_gpgme = yes

alternative_order text/enriched text/plain text

set delete = yes



# Binds


# Macros


# Register accounts
folder-hook /home/vkonda/Mail//AmpereOS// " \
    source /home/vkonda/.config/neomutt-work/AmpereOS "


# Source primary account
source /home/vkonda/.config/neomutt-work/AmpereOS

# Extra configuration
set abort_nosubject=yes
set abort_unmodified=yes
set askcc=yes
set auto_tag=yes
set collapse_unread=no
set edit_headers=yes
set fast_reply=yes
set fcc_attach=yes
set forward_decode=yes
set forward_format="Fwd: %s"
set forward_quote=yes
set include=yes
set mail_check_stats=yes
set mark_old=no
set mbox_type=mbox
set menu_scroll=yes
set pager_context=3
set pager_index_lines=8
set pager_stop=yes
set pipe_decode=yes
set reply_to=yes
set send_charset=us-ascii:utf-8
set sidebar_folder_indent=yes
set smart_wrap=yes
set strict_threads=yes
set text_flowed=yes
set thorough_search=yes
set use_domain=no
set use_from=yes
set user_agent=no
set visual=vim

# Source mailboxes as setup on machine
# source /home/vkonda/.config/neomutt/mailboxes

# Auto-view HTML
auto_view = text/html";

# Deal with the message headers that get shown
# Ignore all of them and hten only show the few
# that we actually care about
ignore *
unignore from: to: cc: date: subject:

# Key bindings
# This file contains key bindings for mutt

# Navigation (vim style)
# Source: https://ryanlue.com/posts/2017-05-21-mutt-the-vim-way

bind generic,index,pager \Cf       next-page
bind generic,index,pager \Cb       previous-page
bind generic,index       G         last-entry
bind pager               G         bottom
bind generic,pager       \Cy       previous-line
bind generic,index,pager \Ce       next-line
bind generic,index,pager \Cd       half-down
bind generic,index,pager \Cu       half-up

# Alternative pager navigation
bind pager <up> previous-line
bind pager <down> next-line
bind pager <right> next-line
bind pager <left> previous-line
bind pager <home> top
bind pager <end> bottom

# Sidebar navigation from index and pager
bind index \CO sidebar-open
bind index \CN sidebar-next
bind index \CP sidebar-prev
bind pager \CO sidebar-open
bind pager \CP sidebar-prev
bind pager \CN sidebar-next

# Composing emails
bind index p recall-message
bind compose p postpone-message

# Collapse threads
bind index - collapse-thread
bind index _ collapse-all

# Marcos for operating on messages
# From https://brianbuccola.com/how-to-mark-all-emails-as-read-in-mutt/
macro index A \
    "<tag-pattern>~N<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>$" \
    "mark all new as read"

# Color Theme

# Enable directcolor support before sourcing any theme files
set color_directcolor=yes

# Source the colors from the theme file
source themes/light-theme.muttrc
