# Add a keybinding to load the light theme
macro index,pager <F5> "<enter-command>source ~/.config/neomutt/themes/light-theme.muttrc<enter>" "Switch to light theme"

# Source the actual theme
source "./everforest-dark-neomutt.muttrc" # Everforest dark theme generted by Codex
# source "./gruvbox-dark-medium.muttrc" # Dark gruvbox theme
